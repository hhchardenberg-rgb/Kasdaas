# ─── Kas Daas — environment variables ──────────────────────────────────────
# Copy to .env.local for local development, and set the same values in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# Public URL of the guide (used for boat links, QR codes and metadata).
NEXT_PUBLIC_SITE_URL=https://kasdaas.example.com

# "true" = allow search engines to index the public guide. Default: hidden.
NEXT_PUBLIC_INDEXABLE=false

# Password for the whole guide (default: see content/private/guest-access.ts).
# Changing it locks every device out until the new password is entered. "off" disables it.
GUEST_PASSWORD=

# REQUIRED in production for boat links. Min. 32 characters, keep it secret.
# Generate with:  openssl rand -base64 48
# Changing it invalidates ALL existing boat links.
BOAT_TOKEN_SECRET=

# Storage for the admin: text edits, accounts and the boat link list (Vercel Blob, private store).
# Set automatically on Vercel when a Blob store is connected. Locally .data/ is used instead.
BLOB_READ_WRITE_TOKEN=

# Optional: comma-separated boat link IDs to revoke before they expire (redeploy needed).
BOAT_REVOKED_IDS=

# Optional: enables /admin (min. 10 characters). Sign in as the user "admin" with this password; it is also
# the secret that signs admin sessions. The owner gets their own account under /admin → Gebruikers.
ADMIN_PASSWORD=

# Automatic translation of the texts the owner edits (Dutch → English, Spanish, German).
# Without it, edits are saved but only appear in Dutch.
ANTHROPIC_API_KEY=
# Optional: model used for translating (default: claude-opus-5-5).
TRANSLATION_MODEL=

# CARTO Basemaps API key for the map tiles (https://carto.com/basemaps/apikey/).
NEXT_PUBLIC_CARTO_API_KEY=

# Optional: register the service worker during `npm run dev` (normally production only).
# NEXT_PUBLIC_SW_DEV=1
